# Copy to .env (which is gitignored) and fill in real values.
# The app runs in its own container and reaches the shared homelab-db
# MariaDB container by name over the homelab-net docker network.
MYSQL_HOST=homelab-db
MYSQL_PORT=3306
MYSQL_DATABASE=kanbanpmdb
MYSQL_USER=gerardok17
MYSQL_PASSWORD=change-me

# Email allowlisted to sign in with Google (bootstraps the seed user). Kept out
# of git — set the real address in the gitignored .env, never here.
SEED_EMAIL=you@example.com

# "Sign in with Google" (OAuth / OIDC). Create a Web application OAuth client in
# Google Cloud Console; keep the real values in the gitignored .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Signs the OAuth state cookie — use a long random value in production.
SESSION_SECRET=change-me
